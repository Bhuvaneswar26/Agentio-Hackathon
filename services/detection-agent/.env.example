CG_DATABASE_URL=postgresql+psycopg://claimsguard:claimsguard@localhost:5432/claimsguard
CG_REDIS_URL=redis://localhost:6379/0
# sync = one request, one full response | background | celery (poll /status and /result)
CG_EXECUTION_MODE=sync
CG_MODEL_DIR=./ml_models
CG_LOG_LEVEL=INFO
CG_DEFAULT_SETTLEMENT_STRATEGY=DEDUCTIBLE_THEN_COPAY
# JSON-valued overrides are supported, e.g.:
# CG_RISK_WEIGHTS={"policy_violations":0.9,"duplicates":0.9,"billing_anomalies":0.6,"ml_models":0.4,"historical_patterns":0.5,"missing_evidence":0.3}
